<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used for the explicit, user-initiated model download; the app never
         calls out to the network for anything else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the model download keep running in a foreground service when the screen is
         off or the app is backgrounded, with a persistent notification showing progress. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Requested lazily on first mic tap, used only for on-device voice input. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Reminders fire as real alarms even while the app is killed. SCHEDULE_EXACT_ALARM is a
         special access the user grants from system Settings on API 31+; AlarmScheduler falls
         back to inexact delivery when it isn't granted. RECEIVE_BOOT_COMPLETED re-arms pending
         reminders after a reboot, since AlarmManager alarms don't survive one. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".PersonalAiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PersonalAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask="false" keeps the download alive if the user swipes the app
             away from Recents while it's running. -->
        <service
            android:name=".service.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
